# Base de datos: URL del "Session pooler" de Supabase (con tu contraseña puesta)
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_CONTRASENA@aws-0-region.pooler.supabase.com:5432/postgres

# Sesión y servidor
JWT_SECRET=pon-aqui-una-frase-larga-y-propia
PORT=3000
APP_URL=http://localhost:3000

# Fotos en Supabase Storage (si quedan vacías, en local se guardan en la carpeta uploads/)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=fotos

# Correo con Brevo (si BREVO_API_KEY queda vacía, el enlace de recuperación sale en la consola)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=FindIt School
